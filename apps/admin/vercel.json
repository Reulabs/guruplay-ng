{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/admin?__route=:path*" },
    { "source": "/api/v1/:path*", "destination": "/api/music?__route=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

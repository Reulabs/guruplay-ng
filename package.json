{
  "name": "guru-music",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@guruplay/web",
    "dev:admin": "turbo run dev --filter=@guruplay/admin",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@guruplay/web",
    "build:admin": "turbo run build --filter=@guruplay/admin",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "turbo run lint",
    "format": "turbo run format"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}

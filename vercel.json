{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/media-worker.mjs": {
      "maxDuration": 300,
      "includeFiles": [
        "node_modules/ffmpeg-static/ffmpeg",
        "node_modules/ffprobe-static/bin/linux/x64/ffprobe"
      ],
      "excludeFiles": "node_modules/ffprobe-static/bin/{darwin,win32,linux/{arm,arm64,ia32}}/**"
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/reconcile",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin?__route=:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/music?__route=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
